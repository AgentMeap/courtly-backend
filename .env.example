# Copy file nay thanh .env roi dien gia tri that. File .env KHONG duoc commit.
# Bien moi truong that (IntelliJ / PowerShell) van duoc uu tien hon file .env.

# Mat khau SQL Server (bat buoc)
DB_PASSWORD=
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=CourtlyDB;encrypt=true;trustServerCertificate=true
# DB_USERNAME=sa

# Gmail gui OTP: dia chi Gmail + App Password 16 ky tu (viet lien, khong dau cach)
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== Docker (docker compose) =====
# Mat khau SA cho SQL Server CHAY TRONG DOCKER (khac voi SQL Server cai tren may).
# SQL Server bat buoc mat khau manh: >= 8 ky tu, co chu hoa, chu thuong, so va ky tu dac biet.
MSSQL_SA_PASSWORD=
# Khoa ky JWT (>= 32 ky tu). Bat buoc khi chay bang Docker hoac SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=
