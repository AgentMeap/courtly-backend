# Copy file nay thanh .env roi dien gia tri that. File .env KHONG duoc commit.
# Bien moi truong that (IntelliJ / PowerShell) van duoc uu tien hon file .env.

# Mat khau SQL Server (bat buoc)
DB_PASSWORD=
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=CourtlyDB;encrypt=true;trustServerCertificate=true
# DB_USERNAME=sa

# Gmail gui OTP (dang ky + quen mat khau): dia chi Gmail + App Password 16 ky tu (viet lien, khong dau cach)
MAIL_USERNAME=
MAIL_PASSWORD=
# Dia chi nguoi gui (de trong = dung MAIL_USERNAME)
MAIL_FROM=

# ===== Dang nhap Google =====
# Chi bat MOT trong hai: Firebase that HOAC mock (bat ca hai thi app khong khoi dong).
#
# 1) Firebase that: project PHAI trung voi google-services.json cua app Flutter (hien la caulong-9b67e).
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=caulong-9b67e
# - Chay bang Docker: dat file JSON tai ./secrets/service-account.json va dung duong dan TRONG container:
#     FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase/service-account.json
# - Chay ./mvnw tren may: duong dan tuyet doi tren may, vd C:\secrets\courtly-firebase.json
#   (bien moi truong that trong IntelliJ/PowerShell duoc uu tien hon gia tri o day)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Web API key cua project Firebase (current_key trong google-services.json cua app Flutter):
# can de /api/auth/login dang nhap duoc tai khoan dang ky qua /api/auth/register/firebase.
FIREBASE_WEB_API_KEY=
#
# 2) Google mock - CHI DUNG CHO DEV/DEMO, KHONG BAO GIO bat o production.
#    Token gia: mock:<email>:<ten hien thi>. App tu choi khoi dong neu bat cung SPRING_PROFILES_ACTIVE=prod.
GOOGLE_MOCK_ENABLED=false

# ===== Docker (docker compose) =====
# Mat khau SA cho SQL Server CHAY TRONG DOCKER (khac voi SQL Server cai tren may).
# SQL Server bat buoc mat khau manh: >= 8 ky tu, co chu hoa, chu thuong, so va ky tu dac biet.
MSSQL_SA_PASSWORD=
# Khoa ky JWT (>= 32 ky tu). Bat buoc khi chay bang Docker hoac SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=
